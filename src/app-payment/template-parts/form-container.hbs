<div class="form">
    <div class="form__header">
        <div class="form__header-top">
            <h1 class="form__title">{{title}}</h1>
        </div>
        <div class="form__header-bot d-none">
            <div class="form__header-bot-col" data-details-type="payment">
                <span>Платеж №</span>
                <strong>[code]</strong>
            </div>
            <div class="form__header-bot-col" data-status data-details-type="status">
                <span>Статус</span>
                <strong>[code]</strong>
            </div>
            <div class="form__header-bot-col" data-details-type="amount">
                <span>Сумма</span>
                <strong>[code]</strong>
            </div>
        </div>
    </div>
    <div class="form__body">
        <div class="form__step" data-step="card">
            <div class="form__body-title">
                <span>{{title}}</span>
            </div>
            <div class="form__body-error d-none"></div>
            <form class="form__actions">
                <div class="form__group">
                    <div class="form__field">
                        <label>
                            <div class="form__field-label">
                                <span>{{cardNumber}}</span>
                            </div>
                            <div class="form__field-card">
                                <input type="text" name="cardNumber" placeholder="0000 0000 0000 0000" class="input-card">
                                <input type="text" name="cardExpire" placeholder="{{mmYY}}" class="input-exp">
                            </div>
                        </label>
                    </div>
                    <div class="form__field form__field-cvv d-none">
                        <label>
                            <div class="form__field-label">
                                <span>{{cardCvv}}</span>
                            </div>
                            <input type="text" name="cvv" placeholder="000" size="3" maxlength="3" class="input-cvv">
                        </label>
                    </div>
                </div>
                <div class="form__field" style="text-align: center;">
                    {{> ../../template-parts/button title=continue selectors="primary bold"}}
                </div>
            </form>
            <div class="form__publicOffer">
                {{{publicOffer}}}
            </div>
        </div>
        <div class="form__step" data-step="code">
            <div class="form__body-title">
                <span>{{smsConfirmation}}</span>
            </div>
            <div class="form__body-desc"></div>
            <form class="form__actions">
                <div class="form__field">
                    <label>
                        <div class="form__field-label">
                            <span>{{codeFromSms}}</span>
                        </div>
                        <div class="form__field-code">
                            <input type="text" maxlength="1" autocomplete="one-time-code" inputmode="numeric"/>
                            <input type="text" maxlength="1" autocomplete="one-time-code" inputmode="numeric"/>
                            <input type="text" maxlength="1" autocomplete="one-time-code" inputmode="numeric"/>
                            <input type="text" maxlength="1" autocomplete="one-time-code" inputmode="numeric"/>
                            <input type="text" maxlength="1" autocomplete="one-time-code" inputmode="numeric"/>
                            <input type="text" maxlength="1" autocomplete="one-time-code" inputmode="numeric"/>
                        </div>
                    </label>
                </div>
                <div class="form__buttons">
                    {{> ../../template-parts/button  selectors="clear resend" attr="disabled"}}
                    {{> ../../template-parts/button title=cancel selectors="clear cancel"}}
                </div>
            </form>
        </div>
        <div class="form__step" data-step="success">
            <div class="form-container">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <use xlink:href="#checkIcon"/>
                </svg>
                <div class="form-container__title">
                    <span>{{{success.paymentSuccess}}}</span>
                </div>
            </div>
        </div>
        <div class="form__step" data-step="error">
            <div class="form-container">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <use xlink:href="#closeIcon"/>
                </svg>
                <div class="form-container__title">
                    <span></span>
                </div>
            </div>
        </div>
        <div class="form__step" data-step="timeout">
            <div class="form-container">
                <svg width="40" height="40" viewBox="0 0 20 20">
                    <use xlink:href="#timeout"/>
                </svg>
                <div class="form-container__title">
                    <span>{{errors.paymentStatusTimedOut}}</span>
                </div>
                <button class="lp-button primary bold">{{checkAgain}}</button>
            </div>
        </div>
        <div class="form__step" data-step="loading">
            <div class="form-container">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <use xlink:href="#spinner"/>
                </svg>
                <strong class="form-container__message">[code]</strong>
            </div>
        </div>
    </div>
</div>